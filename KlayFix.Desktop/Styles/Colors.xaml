<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryLightColor">#3B82F6</Color>
    <Color x:Key="PrimaryDarkColor">#1D4ED8</Color>
    <Color x:Key="SidebarColor">#111827</Color>
    <Color x:Key="BackgroundColor">#F3F4F6</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#374151"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>

    <DropShadowEffect x:Key="CardShadowEffect" Color="#20000000" BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.12"/>
    <DropShadowEffect x:Key="ModalShadowEffect" Color="#40000000" BlurRadius="32" Direction="270" ShadowDepth="8" Opacity="0.15"/>

</ResourceDictionary>



