<Window x:Class="KlayFix.Desktop.Views.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup - KlayFix" Height="220" Width="520" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Database Connection" FontSize="16" FontWeight="Bold" />
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0 12 0 0">
            <TextBlock Text="Enter your SQL Server connection string (e.g. Server=SERVER\\SQLEXPRESS;Database=KlayFixDb;Trusted_Connection=True;)"> </TextBlock>
            <TextBox x:Name="ConnText" Margin="0 8 0 0" Height="26" />
            <TextBlock x:Name="StatusText" Foreground="Red" Margin="0 8 0 0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button x:Name="BtnTest" Content="Test" Width="80" Margin="0 0 8 0" Click="BtnTest_Click" />
            <Button x:Name="BtnSave" Content="Save" Width="80" Margin="0 0 8 0" Click="BtnSave_Click" />
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>