<Window x:Class="KlayFix.Desktop.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="KlayFix ERP - Login"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI"
        TextElement.FontSize="14"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/Colors.xaml"/>
                <ResourceDictionary Source="../../Styles/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="20" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
        <Grid Margin="40 48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Image Grid.Row="0" Width="64" Height="64"
                   Source="/Assets/logo.png"
                   HorizontalAlignment="Center" Margin="0 0 0 16"
                   Stretch="Uniform"/>

            <!-- Title -->
            <TextBlock Grid.Row="1" Text="KlayFix ERP"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0 0 0 4"/>
            <TextBlock Grid.Row="2" Text="Point of Sale &amp; Repair Management"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0 0 0 32"/>

            <!-- Error Message -->
            <Border Grid.Row="3" Background="#FEF2F2" CornerRadius="8" Padding="12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                    Margin="0 0 0 16" BorderBrush="#FECACA" BorderThickness="1">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}" FontSize="13"/>
            </Border>

            <!-- Username -->
            <StackPanel Grid.Row="4" Margin="0 0 0 16">
                <TextBlock Text="Username" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="44" FontSize="14"
                         materialDesign:HintAssist.Hint="Username"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Grid.Row="5" Margin="0 0 0 24">
                <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 6"/>
                <PasswordBox x:Name="PasswordBox" Height="44" FontSize="14"
                             materialDesign:HintAssist.Hint="Password"/>
            </StackPanel>

            <!-- Login Button -->
            <Border Grid.Row="6" Background="{StaticResource PrimaryBrush}"
                    CornerRadius="12" Height="48">
                <Button Content="Login"
                        Command="{Binding LoginCommand}"
                        FontSize="16" FontWeight="SemiBold"
                        Foreground="{StaticResource TextOnPrimaryBrush}"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand"
                        IsDefault="True"
                        Height="48">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="12"
                                                BorderThickness="0"
                                                Opacity="{TemplateBinding Opacity}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>

            <!-- Loading indicator -->
            <ProgressBar Grid.Row="7" IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                         VerticalAlignment="Bottom" Height="3" Margin="0 8 0 0"/>
        </Grid>
    </Border>
</Window>