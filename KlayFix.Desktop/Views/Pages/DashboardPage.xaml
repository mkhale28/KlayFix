<UserControl x:Class="KlayFix.Desktop.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:converters="clr-namespace:KlayFix.Desktop.Converters"
      xmlns:services="clr-namespace:KlayFix.Desktop.Services"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1000"
      Background="{StaticResource BackgroundBrush}">
    <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding [Dashboard_Title], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource PageHeaderStyle}" Margin="0 0 0 4"/>
            <TextBlock Text="{Binding [Dashboard_Description], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource HeaderDescriptionStyle}"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0 0 0 16"/>
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0 0 0 16"/>

            <!-- Metrics Cards -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sales Today Card -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="6" Padding="24">
                    <StackPanel>
                        <Border Background="#EFF6FF" Width="48" Height="48" CornerRadius="12"
                                HorizontalAlignment="Left" Margin="0 0 0 12">
                            <materialDesign:PackIcon Kind="Cash" Width="24" Height="24"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding [Dashboard_SalesToday], Source={x:Static services:LanguageService.Instance}}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalSalesToday, StringFormat={}{0:N2}, Converter={StaticResource CurrencyFormatConverter}}"
                                   FontSize="28" FontWeight="Bold" Margin="0 6 0 0"/>
                        <TextBlock Text="{Binding FormattedInvoiceCount}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 4 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Profit Today Card -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Margin="6" Padding="24">
                    <StackPanel>
                        <Border Background="#ECFDF5" Width="48" Height="48" CornerRadius="12"
                                HorizontalAlignment="Left" Margin="0 0 0 12">
                            <materialDesign:PackIcon Kind="CurrencyUsd" Width="24" Height="24"
                                                     Foreground="{StaticResource SuccessBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding [Dashboard_ProfitToday], Source={x:Static services:LanguageService.Instance}}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ProfitToday, StringFormat={}{0:N2}, Converter={StaticResource CurrencyFormatConverter}}"
                                   FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0 6 0 0"/>
                        <TextBlock Text="{Binding [Dashboard_ProfitSubtitle], Source={x:Static services:LanguageService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 4 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Repairs Card -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Margin="6" Padding="24">
                    <StackPanel>
                        <Border Background="#F3E8FF" Width="48" Height="48" CornerRadius="12"
                                HorizontalAlignment="Left" Margin="0 0 0 12">
                            <materialDesign:PackIcon Kind="Tools" Width="24" Height="24"
                                                     Foreground="#8B5CF6"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding [Dashboard_RepairsOverview], Source={x:Static services:LanguageService.Instance}}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Grid Margin="0 12 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding RepairsReceived}" FontSize="20" FontWeight="Bold"
                                           Foreground="#8B5CF6" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding [Dashboard_New], Source={x:Static services:LanguageService.Instance}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding RepairsInProgress}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding [Dashboard_Active], Source={x:Static services:LanguageService.Instance}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding RepairsCompleted}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding [Dashboard_Done], Source={x:Static services:LanguageService.Instance}}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Low Stock Card -->
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource DashboardCardStyle}" Margin="6" Padding="24">
                    <StackPanel>
                        <Border Background="#FEF2F2" Width="48" Height="48" CornerRadius="12"
                                HorizontalAlignment="Left" Margin="0 0 0 12">
                            <materialDesign:PackIcon Kind="AlertCircle" Width="24" Height="24"
                                                     Foreground="{StaticResource DangerBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding [Dashboard_LowStock], Source={x:Static services:LanguageService.Instance}}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding LowStockCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" Margin="0 6 0 0"/>
                        <TextBlock Text="{Binding [Dashboard_LowStockSubtitle], Source={x:Static services:LanguageService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 4 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Expenses Today (bottom row, left) -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="6" Padding="24">
                    <StackPanel>
                        <Border Background="#FFF7ED" Width="48" Height="48" CornerRadius="12"
                                HorizontalAlignment="Left" Margin="0 0 0 12">
                            <materialDesign:PackIcon Kind="CashRemove" Width="24" Height="24"
                                                     Foreground="{StaticResource WarningBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding [Dashboard_ExpensesToday], Source={x:Static services:LanguageService.Instance}}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalExpensesToday, StringFormat={}{0:N2}, Converter={StaticResource CurrencyFormatConverter}}"
                                   FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0 6 0 0"/>
                        <TextBlock Text="{Binding [Dashboard_ExpensesSubtitle], Source={x:Static services:LanguageService.Instance}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 4 0 0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Low Stock Table -->
            <Border Style="{StaticResource DashboardCardStyle}" Margin="6 16 6 6" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding [Dashboard_LowStockProducts], Source={x:Static services:LanguageService.Instance}}" FontSize="18" FontWeight="SemiBold" Margin="0 0 0 16"/>
                    <Grid>
                        <DataGrid ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False"
                                  Style="{StaticResource ModernDataGridStyle}" Height="200"
                                  Visibility="{Binding LowStockProducts.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [Dashboard_Product], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{Binding [Dashboard_Brand], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Brand}" Width="*"/>
                                <DataGridTextColumn Header="{Binding [Dashboard_Stock], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Quantity}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Visibility="{Binding LowStockProducts.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="CheckCircle" Style="{StaticResource EmptyStateIconStyle}" Foreground="{StaticResource SuccessBrush}" Margin="0 20 0 8"/>
                            <TextBlock Text="{Binding [Dashboard_AllStocked], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource EmptyStateTextStyle}" FontSize="14" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
