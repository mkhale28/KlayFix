<UserControl x:Class="KlayFix.Desktop.Views.Pages.RepairsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:services="clr-namespace:KlayFix.Desktop.Services"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1000"
      Background="{StaticResource BackgroundBrush}">
    <Grid>
        <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding [Repairs_Title], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource PageHeaderStyle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="{Binding [Repairs_AddButton], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding OpenAddModalCommand}" Width="160"/>
                </Grid>

                <TextBlock Text="{Binding [Repairs_Description], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource HeaderDescriptionStyle}"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0 0 0 8"/>

                <Grid Margin="0 0 16 0" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="0"
                            Effect="{StaticResource CardShadowEffect}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" CornerRadius="12 0 0 12" Width="48" Height="48"
                                    HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22"
                                                         Foreground="White"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" FontSize="14" Margin="12 0 0 0"
                                     materialDesign:HintAssist.Hint="{Binding [Repairs_SearchHint], Source={x:Static services:LanguageService.Instance}}"
                                     BorderThickness="0" Background="Transparent"/>
                            <Button Grid.Column="2" Width="32" Height="32" Margin="0 0 8 0"
                                    Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                    Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}}"
                                    Command="{Binding ClearSearchCommand}">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                         Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding StatusFilter}" Height="44"
                              materialDesign:HintAssist.Hint="{Binding [Repairs_StatusHint], Source={x:Static services:LanguageService.Instance}}"/>
                </Grid>

                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0 0 8 0"/>

                <Grid>
                    <ItemsControl ItemsSource="{Binding Repairs}"
                                  Visibility="{Binding Repairs.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="320" Margin="8" CornerRadius="16" Padding="20"
                                        Background="{StaticResource SurfaceBrush}"
                                        Effect="{StaticResource CardShadowEffect}">
                                    <StackPanel>
                                        <Grid Margin="0 0 0 12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding CustomerName}" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CustomerPhone}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBackgroundConverter}}"
                                                    CornerRadius="12" Padding="10 4">
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                            </Border>
                                        </Grid>

                                        <Separator Margin="0 0 0 12"/>

                                        <Grid Margin="0 0 0 8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Cellphone" Width="18" Height="18"
                                                                     Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 8 0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DeviceModel}" FontSize="14" FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0 0 0 4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Barcode" Width="16" Height="16"
                                                                     Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 8 0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DeviceIMEI}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>

                                        <TextBlock Text="{Binding IssueDescription}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0 0 0 12"/>

                                        <Grid Margin="0 0 0 12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Calendar" Width="14" Height="14"
                                                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 4 0"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MMM dd, yyyy}}"
                                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Charge, StringFormat=₱{0:N2}}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="{Binding [Repairs_AdvanceStatus], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource OutlineButtonStyle}"
                                                    Command="{Binding DataContext.UpdateStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Height="36" FontSize="12" Margin="0 0 6 0"/>
                                            <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}"
                                                    Command="{Binding DataContext.PrintRepairReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Height="36" Width="36" Padding="0">
                                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding Repairs.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="Wrench" Style="{StaticResource EmptyStateIconStyle}" Margin="0 40 0 8"/>
                        <TextBlock Text="{Binding [Repairs_Empty], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource EmptyStateTextStyle}" Margin="0"/>
                        <TextBlock Text="{Binding [Repairs_EmptyHint], Source={x:Static services:LanguageService.Instance}}"
                                   Style="{StaticResource EmptyStateTextStyle}" FontSize="13" Margin="0 4 0 40"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Style="{StaticResource ModalContentStyle}" Width="540" Padding="36">
                    <StackPanel>
                        <TextBlock Text="{Binding [Repairs_ModalTitle], Source={x:Static services:LanguageService.Instance}}" FontSize="24" FontWeight="Bold" Margin="0 0 0 24"/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0 0 0 12"/>

                        <TextBlock Text="{Binding [Repairs_FieldCustomer], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 16" Height="44"
                                 materialDesign:HintAssist.Hint="{Binding [Repairs_FieldCustomerHint], Source={x:Static services:LanguageService.Instance}}"/>

                        <TextBlock Text="{Binding [Repairs_FieldPhone], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 16" Height="44"
                                 materialDesign:HintAssist.Hint="{Binding [Repairs_FieldPhoneHint], Source={x:Static services:LanguageService.Instance}}"/>

                        <Grid Margin="0 0 16 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0 0 6 0">
                                <TextBlock Text="{Binding [Repairs_FieldDevice], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding DeviceModel, UpdateSourceTrigger=PropertyChanged}" Height="44"
                                         materialDesign:HintAssist.Hint="{Binding [Repairs_FieldDeviceHint], Source={x:Static services:LanguageService.Instance}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6 0 0 0">
                                <TextBlock Text="{Binding [Repairs_FieldIMEI], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding DeviceImei, UpdateSourceTrigger=PropertyChanged}" Height="44"
                                         materialDesign:HintAssist.Hint="{Binding [Repairs_FieldIMEIHint], Source={x:Static services:LanguageService.Instance}}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding [Repairs_FieldIssue], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding IssueDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 16" Height="88"
                                 materialDesign:HintAssist.Hint="{Binding [Repairs_FieldIssueHint], Source={x:Static services:LanguageService.Instance}}"
                                 AcceptsReturn="True" TextWrapping="Wrap"/>

                        <Grid Margin="0 0 24 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0 0 6 0">
                                <TextBlock Text="{Binding [Repairs_FieldCost], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Cost, UpdateSourceTrigger=LostFocus}" Height="44"
                                         materialDesign:HintAssist.Hint="{Binding [Repairs_FieldCostHint], Source={x:Static services:LanguageService.Instance}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6 0 0 0">
                                <TextBlock Text="{Binding [Repairs_FieldCharge], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Charge, UpdateSourceTrigger=LostFocus}" Height="44"
                                         materialDesign:HintAssist.Hint="{Binding [Repairs_FieldChargeHint], Source={x:Static services:LanguageService.Instance}}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="{Binding [Repairs_Cancel], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource OutlineButtonStyle}"
                                    Command="{Binding CloseModalCommand}" Width="120" Margin="0 0 12 0"/>
                            <Button Grid.Column="2" Content="{Binding [Repairs_CreateTicket], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding SaveRepairCommand}" Width="140"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
