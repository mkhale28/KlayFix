<UserControl x:Class="KlayFix.Desktop.Views.Pages.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:KlayFix.Desktop.ViewModels"
      xmlns:services="clr-namespace:KlayFix.Desktop.Services"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- Products Panel -->
        <Border Grid.Column="0" Margin="28 28 14 28" CornerRadius="16"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0 0 0 12">
                    <TextBlock Text="{Binding [Sales_Title], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource PageHeaderStyle}"/>
                    <TextBlock Text="{Binding [Sales_Description], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource HeaderDescriptionStyle}" Margin="0 2 0 0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0 0 0 8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="0" Margin="0 0 0 10" Height="48"
                        Effect="{StaticResource CardShadowEffect}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" CornerRadius="12 0 0 12" Width="48" Height="48"
                                HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22"
                                                     Foreground="White"
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBox Grid.Column="1" Text="{Binding ProductSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" FontSize="14" Margin="12 0 0 0"
                                 materialDesign:HintAssist.Hint="{Binding [Sales_SearchHint], Source={x:Static services:LanguageService.Instance}}"
                                 BorderThickness="0" Background="Transparent"/>
                        <Button Grid.Column="2" Width="32" Height="32" Margin="0 0 8 0"
                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                Visibility="{Binding ProductSearchQuery, Converter={StaticResource StringToVisibilityConverter}}"
                                Command="{Binding ClearSearchCommand}">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Barcode Scanner Input -->
                <Border Grid.Row="3" Background="{StaticResource PrimaryBrush}" CornerRadius="12" Padding="0" Margin="0 0 0 12" Height="48"
                        Effect="{StaticResource CardShadowEffect}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FFFFFF22" Width="48" Height="48" CornerRadius="12 0 0 12">
                            <materialDesign:PackIcon Kind="BarcodeScan" Width="24" Height="24"
                                                     Foreground="White"
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBox x:Name="ScannerInputBox" Grid.Column="1" Text="{Binding ScannerInput, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" FontSize="14" Foreground="White" Margin="12 0 0 0"
                                 materialDesign:HintAssist.Hint="{Binding [Sales_ScanHint], Source={x:Static services:LanguageService.Instance}}"
                                 materialDesign:HintAssist.Foreground="#AAFFFFFF"
                                 BorderThickness="0" Background="Transparent"
                                 CaretBrush="White">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchByBarcodeCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Border Grid.Column="2" Background="#FFFFFF33"
                                CornerRadius="4" Padding="8 4" Margin="0 0 12 0" Visibility="{Binding ScannerStatus, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding ScannerStatus}" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Products}"
                                      Visibility="{Binding Products.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ProductCardStyle}"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Brand, StringFormat={} ({0})}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SellingPrice, StringFormat=₱{0:N2}}"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}" Margin="0 6 0 0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                                                <TextBlock Text="{Binding [Sales_StockLabel], Source={x:Static services:LanguageService.Instance}}"
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Quantity}"
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding Products.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="StoreSearch" Style="{StaticResource EmptyStateIconStyle}" Margin="0 40 0 8"/>
                            <TextBlock Text="{Binding [Sales_NoProducts], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource EmptyStateTextStyle}" Margin="0"/>
                            <TextBlock Text="{Binding [Sales_NoProductsHint], Source={x:Static services:LanguageService.Instance}}"
                                       Style="{StaticResource EmptyStateTextStyle}" FontSize="13" Margin="0 4 0 40"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Cart Panel -->
        <Border Grid.Column="1" Margin="14 28 28 28" CornerRadius="16"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding [Sales_Cart], Source={x:Static services:LanguageService.Instance}}" FontSize="22" FontWeight="Bold" Margin="0 0 0 4"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 16">
                    <TextBlock FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding CartItemCount, Mode=OneWay}"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding [Sales_ItemsInCart], Source={x:Static services:LanguageService.Instance}}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding CartItems}"
                                      Visibility="{Binding CartItems.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CartItemViewModel}">
                                    <Border Background="#F9FAFB" CornerRadius="12" Padding="12" Margin="0 0 0 8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ProductBrand}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <Button Grid.Row="0" Grid.Column="1" Width="24" Height="24" Padding="0"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                                         Foreground="{StaticResource DangerBrush}"/>
                                            </Button>

                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0 8 0 0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Width="28" Height="28"
                                                        Background="#E5E7EB" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="-" FontSize="16" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <Border Grid.Column="1" Margin="6 0" Width="36" Height="28"
                                                        Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding Quantity}" FontSize="14" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <Button Grid.Column="2" Width="28" Height="28"
                                                        Background="#E5E7EB" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <TextBlock Grid.Column="3" Text="{Binding Total, StringFormat=₱{0:N2}}"
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           VerticalAlignment="Center" Margin="12 0 0 0"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding CartItems.Count, Converter={StaticResource InverseCountToVisibilityConverter}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="CartOutline" Style="{StaticResource EmptyStateIconStyle}" Margin="0 20 0 8"/>
                            <TextBlock Text="{Binding [Sales_EmptyCart], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource EmptyStateTextStyle}" Margin="0"/>
                            <TextBlock Text="{Binding [Sales_EmptyCartHint], Source={x:Static services:LanguageService.Instance}}"
                                       Style="{StaticResource EmptyStateTextStyle}" FontSize="13" Margin="0 4 0 20"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Summary -->
                <Border Grid.Row="3" Background="#F9FAFB" CornerRadius="12" Padding="16" Margin="0 12 0 0">
                    <StackPanel>
                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [Sales_Subtotal], Source={x:Static services:LanguageService.Instance}}" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=₱{0:N2}}" FontSize="14" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [Sales_Discount], Source={x:Static services:LanguageService.Instance}}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" Height="32" TextAlignment="Right" FontSize="13"
                                     materialDesign:HintAssist.Hint="0.00"/>
                        </Grid>
                        <Separator Margin="0 8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [Sales_Total], Source={x:Static services:LanguageService.Instance}}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=₱{0:N2}}"
                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Payment Method -->
                <Border Grid.Row="4" Background="#F9FAFB" CornerRadius="12" Padding="16" Margin="0 8 0 0">
                    <StackPanel>
                        <TextBlock Text="{Binding [Sales_PaymentMethod], Source={x:Static services:LanguageService.Instance}}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="PaymentMethod"
                                         IsChecked="{Binding IsCashPayment}"
                                         Content="{Binding [Sales_Cash], Source={x:Static services:LanguageService.Instance}}" Margin="0 0 8 0"
                                         FontSize="14" FontWeight="SemiBold">
                                <RadioButton.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Cash" Width="18" Height="18" Foreground="{StaticResource SuccessBrush}" Margin="0 0 6 0"/>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </RadioButton.ContentTemplate>
                            </RadioButton>
                            <RadioButton Grid.Column="1" GroupName="PaymentMethod"
                                         IsChecked="{Binding IsCardPayment}"
                                         Content="{Binding [Sales_Card], Source={x:Static services:LanguageService.Instance}}" Margin="8 0 0 0"
                                         FontSize="14" FontWeight="SemiBold">
                                <RadioButton.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CreditCard" Width="18" Height="18" Foreground="{StaticResource PrimaryBrush}" Margin="0 0 6 0"/>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </RadioButton.ContentTemplate>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid Grid.Row="6" Margin="0 12 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding [Sales_ClearCart], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding ClearCartCommand}" Margin="0 0 6 0"/>
                    <Button Grid.Column="1" Content="{Binding [Sales_CompleteSale], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding CompleteSaleCommand}" Margin="6 0 0 0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Invoice Modal -->
        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding ShowInvoicePanel, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Style="{StaticResource ModalContentStyle}" Width="480" Padding="32">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                            <Border Background="{StaticResource SuccessBrush}" Width="48" Height="48" CornerRadius="24"
                                    HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="Check" Width="24" Height="24"
                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="16 0 0 0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Sales_Completed], Source={x:Static services:LanguageService.Instance}}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="{Binding LastSale.InvoiceNumber}" FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0 0 0 16"/>

                        <TextBlock Text="{Binding [Sales_InvoiceSummary], Source={x:Static services:LanguageService.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 12"/>

                        <ItemsControl ItemsSource="{Binding LastSale.Items}" MaxHeight="200">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0 0 0 6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="13">
                                            <Run Text="{Binding ProductName}"/>
                                            <Run Text=" x "/>
                                            <Run Text="{Binding Quantity}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalPrice, StringFormat=₱{0:N2}}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0 12"/>

                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [Sales_TotalLabel], Source={x:Static services:LanguageService.Instance}}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastSale.NetAmount, StringFormat=₱{0:N2}}"
                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding [Sales_Payment], Source={x:Static services:LanguageService.Instance}}"/>
                            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding LastSale.PaymentMethod}"/>
                        </StackPanel>

                        <Grid Margin="0 0 0 24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Receipt" Width="16" Height="16"
                                                     Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0 0 4 0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding [Sales_Reference], Source={x:Static services:LanguageService.Instance}}"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding LastSale.InvoiceNumber}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding [Sales_PrintReceipt], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource OutlineButtonStyle}"
                                    Command="{Binding PrintReceiptCommand}" Width="160" HorizontalAlignment="Center" Margin="0 0 6 0"/>
                            <Button Grid.Column="1" Content="{Binding [Sales_Close], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding CloseInvoiceCommand}" Width="160" HorizontalAlignment="Center" Margin="6 0 0 0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
