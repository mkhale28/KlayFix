<UserControl x:Class="KlayFix.Desktop.Views.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:services="clr-namespace:KlayFix.Desktop.Services"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1000"
      Background="{StaticResource BackgroundBrush}">
    <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0 0 0 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding [Reports_Title], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource PageHeaderStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="{Binding [Reports_Refresh], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding RefreshCommand}" Width="140"/>
            </Grid>

            <TextBlock Text="{Binding [Reports_Description], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource HeaderDescriptionStyle}"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0 0 0 8"/>
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0 0 0 8"/>

            <!-- Daily Sales Report -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" Margin="0 0 0 16"
                    Effect="{StaticResource CardShadowEffect}">
                <StackPanel>
                    <Grid Margin="0 0 16 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [Reports_DailySales], Source={x:Static services:LanguageService.Instance}}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 24 0"/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [Reports_SelectDate], Source={x:Static services:LanguageService.Instance}}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0 0 12 0"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding DailyReportDate}"
                                        Width="180" Height="36" FontSize="13"/>
                        </Grid>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="12" Padding="20" Margin="4">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Cash" Width="20" Height="20"
                                                         Foreground="{StaticResource PrimaryBrush}" Margin="0 0 0 6"/>
                                <TextBlock Text="{Binding [Reports_TotalSales], Source={x:Static services:LanguageService.Instance}}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DailyReport.TotalSales, StringFormat=₱{0:N2}}"
                                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="12" Padding="20" Margin="4">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="CurrencyUsd" Width="20" Height="20"
                                                         Foreground="{StaticResource SuccessBrush}" Margin="0 0 0 6"/>
                                <TextBlock Text="{Binding [Reports_TotalProfit], Source={x:Static services:LanguageService.Instance}}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DailyReport.TotalProfit, StringFormat=₱{0:N2}}"
                                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#F3E8FF" CornerRadius="12" Padding="20" Margin="4">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Receipt" Width="20" Height="20"
                                                         Foreground="#8B5CF6" Margin="0 0 0 6"/>
                                <TextBlock Text="{Binding [Reports_Invoices], Source={x:Static services:LanguageService.Instance}}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DailyReport.InvoiceCount}"
                                           FontSize="22" FontWeight="Bold" Foreground="#8B5CF6"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Monthly Report -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" Margin="0 0 0 16"
                    Effect="{StaticResource CardShadowEffect}">
                <StackPanel>
                    <Grid Margin="0 0 16 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [Reports_MonthlyReport], Source={x:Static services:LanguageService.Instance}}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Years}"
                                  SelectedItem="{Binding SelectedYear}"
                                  Width="120" Height="36" Margin="16 0 0 0" FontSize="13"/>
                    </Grid>
                    <Grid>
                        <DataGrid ItemsSource="{Binding MonthlyReports}" Style="{StaticResource ModernDataGridStyle}" MaxHeight="300"
                                  Visibility="{Binding MonthlyReports.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [Reports_Month], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding MonthName}" Width="120"/>
                                <DataGridTextColumn Header="{Binding [Reports_Sales], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding TotalSales, StringFormat=₱{0:N2}}" Width="*"/>
                                <DataGridTextColumn Header="{Binding [Reports_Profit], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding TotalProfit, StringFormat=₱{0:N2}}" Width="*"/>
                                <DataGridTextColumn Header="{Binding [Reports_Expenses], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding TotalExpenses, StringFormat=₱{0:N2}}" Width="*"/>
                                <DataGridTextColumn Header="{Binding [Reports_NetProfit], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding NetProfit, StringFormat=₱{0:N2}}" Width="*"/>
                                <DataGridTextColumn Header="{Binding [Reports_Invoices], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding InvoiceCount}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Visibility="{Binding MonthlyReports.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="ChartLine" Style="{StaticResource EmptyStateIconStyle}" Margin="0 20 0 8"/>
                            <TextBlock Text="{Binding [Reports_NoMonthlyData], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource EmptyStateTextStyle}" FontSize="14" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Inventory Report -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" Margin="0 0 0 16"
                    Effect="{StaticResource CardShadowEffect}">
                <StackPanel>
                    <TextBlock Text="{Binding [Reports_InventoryReport], Source={x:Static services:LanguageService.Instance}}" FontSize="18" FontWeight="SemiBold" Margin="0 0 16 0"/>
                    <Grid>
                        <DataGrid ItemsSource="{Binding InventoryReport}" Style="{StaticResource ModernDataGridStyle}" MaxHeight="300"
                                  Visibility="{Binding InventoryReport.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [Reports_Product], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{Binding [Reports_Brand], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Brand}" Width="120"/>
                                <DataGridTextColumn Header="{Binding [Reports_Category], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Category}" Width="100"/>
                                <DataGridTextColumn Header="{Binding [Reports_InStock], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="{Binding [Reports_CostPrice], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding PurchasePrice, StringFormat=₱{0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="{Binding [Reports_SellingPrice], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding SellingPrice, StringFormat=₱{0:N2}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Visibility="{Binding InventoryReport.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Style="{StaticResource EmptyStateIconStyle}" Margin="0 20 0 8"/>
                            <TextBlock Text="{Binding [Reports_NoInventory], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource EmptyStateTextStyle}" FontSize="14" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Repair Report -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" Margin="0 0 0 16"
                    Effect="{StaticResource CardShadowEffect}">
                <StackPanel>
                    <TextBlock Text="{Binding [Reports_RepairSummary], Source={x:Static services:LanguageService.Instance}}" FontSize="18" FontWeight="SemiBold" Margin="0 0 16 0"/>
                    <Grid>
                        <DataGrid ItemsSource="{Binding RepairReport}" Style="{StaticResource ModernDataGridStyle}" MaxHeight="300"
                                  Visibility="{Binding RepairReport.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [Reports_Customer], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="{Binding [Reports_Device], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding DeviceModel}" Width="*"/>
                                <DataGridTextColumn Header="{Binding [Reports_Status], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="{Binding [Reports_Charge], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Charge, StringFormat=₱{0:N2}}" Width="100"/>
                                <DataGridTextColumn Header="{Binding [Reports_Date], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding CreatedAt, StringFormat={}{0:MMM dd, yyyy}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Visibility="{Binding RepairReport.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="Wrench" Style="{StaticResource EmptyStateIconStyle}" Margin="0 20 0 8"/>
                            <TextBlock Text="{Binding [Reports_NoRepairs], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource EmptyStateTextStyle}" FontSize="14" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
