<UserControl x:Class="KlayFix.Desktop.Views.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:KlayFix.Desktop.ViewModels"
      xmlns:services="clr-namespace:KlayFix.Desktop.Services"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1000"
      Background="{StaticResource BackgroundBrush}">
    <Grid>
        <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding [Products_Title], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource PageHeaderStyle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="{Binding [Products_AddButton], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding OpenAddModalCommand}" Width="160"/>
                </Grid>

                <TextBlock Text="{Binding [Products_Description], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource HeaderDescriptionStyle}"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0 0 0 8"/>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="0" Margin="0 0 0 16" Height="48"
                        Effect="{StaticResource CardShadowEffect}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" CornerRadius="12 0 0 12" Width="48" Height="48"
                                HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22"
                                                     Foreground="White"
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" FontSize="14" Margin="12 0 0 0"
                                 materialDesign:HintAssist.Hint="{Binding [Products_SearchHint], Source={x:Static services:LanguageService.Instance}}"
                                 BorderThickness="0" Background="Transparent"/>
                        <Button Grid.Column="2" Width="32" Height="32" Margin="0 0 8 0"
                                Background="#F3F4F6" BorderThickness="0" Cursor="Hand"
                                Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}}"
                                Command="{Binding ClearSearchCommand}">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0 0 0 8"/>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                        Effect="{StaticResource CardShadowEffect}" Padding="0">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Products}" Style="{StaticResource ModernDataGridStyle}" MaxHeight="600"
                                  Visibility="{Binding Products.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [Products_Name], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{Binding [Products_Brand], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Brand}" Width="120"/>
                                <DataGridTextColumn Header="{Binding [Products_Category], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Category}" Width="100"/>
                                <DataGridTextColumn Header="{Binding [Products_SellingPrice], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding SellingPrice, StringFormat=₱{0:N2}}" Width="130"/>
                                <DataGridTextColumn Header="{Binding [Products_Cost], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding PurchasePrice, StringFormat=₱{0:N2}}" Width="130"/>
                                <DataGridTextColumn Header="{Binding [Products_Stock], Source={x:Static services:LanguageService.Instance}}" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTemplateColumn Header="{Binding [Products_Actions], Source={x:Static services:LanguageService.Instance}}" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Width="32" Height="32" Margin="2"
                                                        Background="#EFF6FF" BorderThickness="0"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.OpenEditModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"
                                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                                </Button>
                                                <Button Width="32" Height="32" Margin="2"
                                                        Background="#FEF2F2" BorderThickness="0"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}">
                                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"
                                                                             Foreground="{StaticResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Visibility="{Binding Products.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Style="{StaticResource EmptyStateIconStyle}" Margin="0 48 0 8"/>
                            <TextBlock Text="{Binding [Products_Empty], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource EmptyStateTextStyle}" Margin="0"/>
                            <TextBlock Text="{Binding [Products_EmptyHint], Source={x:Static services:LanguageService.Instance}}"
                                       Style="{StaticResource EmptyStateTextStyle}" FontSize="13" Margin="0 4 0 48"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Style="{StaticResource ModalContentStyle}" Width="540" Padding="36">
                    <StackPanel>
                        <TextBlock Text="{Binding ModalTitle}" FontSize="24" FontWeight="Bold" Margin="0 0 0 24"/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0 0 0 12"/>

                        <TextBlock Text="{Binding [Products_FieldName], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 16" Height="44"
                                 materialDesign:HintAssist.Hint="{Binding [Products_FieldNameHint], Source={x:Static services:LanguageService.Instance}}"/>

                        <Grid Margin="0 0 0 16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0 0 6 0">
                                <TextBlock Text="{Binding [Products_FieldBrand], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Height="44"
                                         materialDesign:HintAssist.Hint="{Binding [Products_FieldBrandHint], Source={x:Static services:LanguageService.Instance}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6 0 0 0">
                                <TextBlock Text="{Binding [Products_FieldCategory], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding Category}" Height="44"
                                          materialDesign:HintAssist.Hint="{Binding [Products_FieldCategoryHint], Source={x:Static services:LanguageService.Instance}}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0 0 0 16">
                            <TextBlock Text="{Binding [Products_FieldIMEI], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding Imei, UpdateSourceTrigger=PropertyChanged}" Height="44"
                                     materialDesign:HintAssist.Hint="{Binding [Products_FieldIMEIHint], Source={x:Static services:LanguageService.Instance}}"/>
                        </StackPanel>

                        <Grid Margin="0 0 0 24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0 0 6 0">
                                <TextBlock Text="{Binding [Products_FieldCost], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=LostFocus}" Height="44"
                                         materialDesign:HintAssist.Hint="{Binding [Products_FieldCostHint], Source={x:Static services:LanguageService.Instance}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6 0 6 0">
                                <TextBlock Text="{Binding [Products_FieldPrice], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=LostFocus}" Height="44"
                                         materialDesign:HintAssist.Hint="{Binding [Products_FieldPriceHint], Source={x:Static services:LanguageService.Instance}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6 0 0 0">
                                <TextBlock Text="{Binding [Products_FieldStock], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Height="44"
                                         materialDesign:HintAssist.Hint="{Binding [Products_FieldStockHint], Source={x:Static services:LanguageService.Instance}}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="{Binding [Products_Cancel], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource OutlineButtonStyle}"
                                    Command="{Binding CloseModalCommand}" Width="120" Margin="0 0 12 0"/>
                            <Button Grid.Column="2" Content="{Binding [Products_Save], Source={x:Static services:LanguageService.Instance}}" Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding SaveProductCommand}" Width="120"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
