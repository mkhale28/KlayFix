<UserControl x:Class="KlayFix.Desktop.Controls.ConfirmationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:KlayFix.Desktop.Services"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
             x:Name="ConfirmationRoot">

    <Border Style="{StaticResource ModalOverlayStyle}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
            Panel.ZIndex="999">
        <Grid>
            <Border Style="{StaticResource ConfirmDialogStyle}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="40" Height="40"
                                             Foreground="{StaticResource WarningBrush}"
                                             HorizontalAlignment="Center" Margin="0 0 0 16"/>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding Message}" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               Margin="0 0 0 24" MaxWidth="320"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding CancelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0 0 6 0"/>
                                <TextBlock Text="{Binding [Confirm_Cancel], Source={x:Static services:LanguageService.Instance}}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding ConfirmCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Margin="0 0 6 0"/>
                                <TextBlock Text="{Binding [Confirm_Confirm], Source={x:Static services:LanguageService.Instance}}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
