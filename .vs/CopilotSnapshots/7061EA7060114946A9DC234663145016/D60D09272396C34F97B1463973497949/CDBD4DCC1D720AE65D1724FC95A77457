<UserControl x:Class="KlayFix.Desktop.Views.Pages.BackupPage"
             x:ClassModifier="public"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:KlayFix.Desktop.Services"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 24">
            <TextBlock FontSize="28" FontWeight="Bold"
                       Text="{Binding [Backup_Title], Source={x:Static services:LanguageService.Instance}}"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock FontSize="14" Margin="0 4 0 0"
                       Text="{Binding [Backup_Subtitle], Source={x:Static services:LanguageService.Instance}}"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 20">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CreateBackupCommand}" Padding="20 10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BackupRestore" Width="20" Height="20" Margin="0 0 8 0"/>
                            <TextBlock Text="Create Backup"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButtonStyle}" Margin="12 0 0 0" Padding="20 10"
                            Command="{Binding OpenBackupFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20" Margin="0 0 8 0"/>
                            <TextBlock Text="Open Backup Folder"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="1" Background="#F0FDF4" CornerRadius="8" Padding="12"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                        Margin="0 0 0 16">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#166534" FontSize="13"/>
                </Border>

                <TextBlock Grid.Row="2" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 12"
                           Text="Available Backups"/>

                <DataGrid Grid.Row="3" ItemsSource="{Binding Backups}"
                          SelectedItem="{Binding SelectedBackup}"
                          AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300"
                          Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="100"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                        <DataGridTemplateColumn Header="Actions" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DangerButtonStyle}" Padding="8 4"
                                            Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="4" Background="#FEF2F2" CornerRadius="12" Padding="20" Margin="0 16 0 0">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#991B1B" Margin="0 0 0 8"
                                   Text="Restore"/>
                        <TextBlock FontSize="13" Foreground="#7F1D1D" Margin="0 0 0 12"
                                   Text="Select a backup above and click Restore to create a restored database copy."/>
                        <Button Style="{StaticResource DangerButtonStyle}" Padding="20 10"
                                Command="{Binding RestoreBackupCommand}"
                                IsEnabled="{Binding SelectedBackup, Converter={StaticResource InverseNullToBoolConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Restore" Width="20" Height="20" Margin="0 0 8 0"/>
                                <TextBlock Text="Restore Selected Backup"/>
                            </StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Margin="0 12 0 0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
